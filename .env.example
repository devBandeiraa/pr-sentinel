# Copie para .env e preencha. Nunca faça commit do .env.

# GitHub App
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_PRIVATE_KEY_FILE=./secrets/github-app.pem

# LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Review publicada no PR
# true faz o bot postar REQUEST_CHANGES quando pede mudanças, o que bloqueia o merge em
# repositório com branch protection até alguém dar dismiss. Veja o README antes de ligar.
PUBLISHER_REQUEST_CHANGES=false

# Infra
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
POSTGRES_USER=prsentinel
POSTGRES_PASSWORD=prsentinel
